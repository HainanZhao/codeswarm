
Note,MarkdownNote {    
    padding: 0 1 0 0;
    background: $primary 5%;
    border-left: solid $primary 45%;
    &.-error {
        background: $error 7%;
        border-left: solid $error;
    }    
    &.-stop-reason {
        border: wide $error 50%;
        padding: 0 1;
        MarkdownH2 {
            margin: 1 0 1 0;
        }
    }
    &.-agent-identity {
        color: $text-secondary;
        height: 1;
        margin: 1 0 0 0;
        padding: 0;
    }
}


Conversation {    
    Window {                      
        layout: stream;
        margin: 0;                
        scrollbar-size-vertical: 2;        
        padding: 0 1 0 1;       
        height: 1fr;                
        align: left bottom;   
    }

    &.-scrollbar-thin {
        Window {
            # scrollbar-gutter: stable;
            scrollbar-size-vertical: 1;
        }
        
    }
    &.-scrollbar-hidden {
        Window {
            # scrollbar-gutter: auto;
            scrollbar-size-vertical: 0;
        }
    }

    &.-relay-paused {
        Prompt #prompt-container {
            border: tall $warning;
        }
    }

    height: 1fr;
    layers: base prompt float;        

    
    Contents {        
        layout: stream;
        width: 1fr;
        overflow: hidden;         
        height: auto;  
        padding: 0 0 0 0;                         
    }    

    ContentsGrid {            
        grid-size: 2;
        grid-columns: 1 1fr;
        grid-rows: auto;
        height: auto;                
    }

    #cursor-container {            
        height: auto;
        width: 1;                    
        color: $foreground 7%;            
                
        &> Cursor {
            height: 0;            
            width: 1;     
                                 
            border-left: outer $text-accent;
            visibility: visible;
            &.-blink {
                border-left: outer $text-accent 20%;
            } 
        }
    }        

    AgentMessage {
        height: auto;
        padding: 0 1 0 1;
        background: $foreground 4%;
        border-left: solid $primary;
        border-bottom: solid $primary 25%;

        &.-agent-tone-0 {
            background: $agent-tone-0 5%;
            border-left: solid $agent-tone-0;
            border-bottom: solid $agent-tone-0 25%;
        }
        &.-agent-tone-1 {
            background: $agent-tone-1 5%;
            border-left: solid $agent-tone-1;
            border-bottom: solid $agent-tone-1 25%;
        }
        &.-agent-tone-2 {
            background: $agent-tone-2 5%;
            border-left: solid $agent-tone-2;
            border-bottom: solid $agent-tone-2 25%;
        }
        &.-agent-tone-3 {
            background: $agent-tone-3 5%;
            border-left: solid $agent-tone-3;
            border-bottom: solid $agent-tone-3 25%;
        }

        &.block {
            margin: 0 1 0 0;
        }

        #agent-message-header {
            height: 1;
            width: 1fr;
            margin: 0;
            padding: 0 1;

            &.-agent-tone-0 {
                background: $agent-tone-0 16%;
            }
            &.-agent-tone-1 {
                background: $agent-tone-1 16%;
            }
            &.-agent-tone-2 {
                background: $agent-tone-2 16%;
            }
            &.-agent-tone-3 {
                background: $agent-tone-3 16%;
            }
        }

        AgentToolActivity {
            height: auto;
            min-height: 0;
            margin: 0;
            padding: 0;
            background: transparent;

            #tool-activity-summary {
                height: 1;
                width: 1fr;
                margin: 0 1 0 0;
                color: $primary;
                text-style: dim;
                text-overflow: ellipsis;
            }

            ToolCall {
                margin: 0 !important;
            }

            &:focus {
                #tool-activity-summary,
                ToolCallHeader {
                    color: $text-primary;
                }
            }
        }
    }

    AgentResponse {         
        min-height: 1;        
        margin: 0;
        padding: 0;
        background: transparent;
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
        layout: stream;
        & > MarkdownBlock:last-child {            
            margin-bottom: 0;
        }

        MarkdownHorizontalRule {
            padding-top: 0;
            margin-bottom: 0;
        }
    }

    LoadingIndicator {
        height: 10;
    }

    AgentThought {
        background: $primary 6%;
        color: $text-primary;        
        min-height: 1;        
        margin: 1 1 1 0;
        padding:  0 1 0 1;
        border-left: solid $primary 50%;
        border-bottom: solid $primary 20%;
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
        layout: stream;
        MarkdownBlock:last-child {
            margin-bottom: 0;
        }
       
        &.-loading {            
            background: transparent !important;
            border: none;
            padding: 0;
            margin: 0;            
        }
        max-height: 10;
        overflow-y: auto;
        scrollbar-visibility: hidden;

        &:focus {
            border: tall $primary;
        }
    }

    ToolCall {    
        margin: 0 !important;
        padding-left: 1;
        border-left: solid $primary 25%;
        
        width: 1fr;
        layout: stream;
        height: auto;        

        .icon {
            width: auto;
            margin-right: 1;
        }
        #tool-content {
            display: none;
        }
        &.-has-content #tool-content {            
            margin: 1 1 1 0;            
            DiffView {
                margin: 0 1 1 0;                                              
                &:last-of-type {
                    margin-bottom: 0; 
                }
            }

            Markdown {                
                layout: stream;
                padding: 0;
                margin: 0 0 0 0;
                MarkdownBlock:last-of-type {
                    margin-bottom: 0;
                }
            }                  
        }
        &.-expanded {
            #tool-content {
                display: block;                
            }
            ToolCallHeader {
                text-wrap: wrap;
                text-overflow: fold;
            }
        }
        
        ToolCallHeader {  
            color: $primary;
            pointer: pointer;       
            width: auto;
            max-width: 1fr;   
            margin: 0 1 0 0;    
            text-wrap: nowrap;
            text-overflow: ellipsis;
        }        
    }
    padding-left: 1;  

   

    ShellResult {        
        border-left: blank $primary;
        background: $foreground 4%;        
        padding: 1 0;   
        margin: 1 1 1 0; 
        #prompt {
            margin: 0 1 0 0;
            color: $text-primary;            
        }  
    }
    
    Terminal {        
        width: 1fr;
        height: auto;
        padding: 0 1 0 0;
        margin: 1 0;
        overflow: scroll;
        scrollbar-size: 0 0;          
    }

    TerminalTool {
        height: auto;   
        border: panel $primary 50%;                  
        border-title-color: $text-primary;
        background: $primary 10%;        
        padding: 1 1 0 1;              
        border-title-style: bold;

        &.-success {            
            border: panel $success-muted;                  
            border-title-color: $text-success;
            background: $success 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $success 50%;                  
                border-title-color: auto 90%;
            }
        }
        

        &.-error {            
            border: panel $error-muted;                  
            border-title-color: $text-error;
            background: $error 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $error-muted;                  
                border-title-color: auto 90%;
            }
        }
                  
    }
         
    UserInput {        
        height: auto;
        margin: 0 1 1 0;
        padding: 0;
        align: right top;

        #user-bubble {
            width: 80%;
            height: auto;
            border-right: solid $primary;
            background: $primary 10%;
            padding: 0 0 0 1;

            Markdown {
                padding: 0;
            }
            Markdown > MarkdownBlock:last-child {
                margin-bottom: 0;
            }
            MarkdownFence {
                margin: 0 2 1 0;
            }
            #prompt {
                margin: 0 0 0 1;
                color: $primary;
                text-style: bold;
            }
        }
    }

    &.-narrow UserInput #user-bubble {
        width: 90%;
    }

}


ACPToolCallContent {
    Markdown {        
        margin: 0;
        padding-left: 0;
        MarkdownBlock:last-of-type {
            margin-bottom: 0;
        }
    }
}


Prompt {            
    padding: 0;
    height: auto;  
    dock: bottom;  
   
    PathSearch, SlashComplete {
        display: none;
        overlay: screen;
        offset-y: -16;
        height: 16;
        Input {
            margin: 0 1;
            padding: 0 1;
        }
        OptionList,FuzzyPathOptionList {
            border: none;
            height: 1fr;           
            padding: 0;
            margin: 0 1;                     
            overflow: hidden;
            text-wrap: nowrap;
            text-overflow: ellipsis;  
            & > .option-list--option {
                padding: 0 1;             
            }
        }
    }

    &.-show-path-search {
        PathSearch {
            display: block
        }
    }

    &.-show-slash-complete {
        SlashComplete {
            display: block;
        }
    }

    Question {
        
        display: none;
        #title {
            width: 1fr;            
        }
        height: auto;                
        # height: 1fr;
        # max-height: 50vh;
        # overflow: hidden auto;

        #contents {
            
            margin-top: 0;            
            height: auto;            
            overflow: hidden auto;
            max-height: 50vh;  
            margin-bottom: 1;
            
            
            DiffView {
                .diff-group {                    
                    margin-bottom: 0;
                }
            }
            #title {
                margin: 0;
            }
            & > * {                
                # height: 0;
                padding-right: 1;
                margin: 1 0 0 0;
            } 
                     
            &:empty {
                height: 1;                
            }
        }
        #option-container {
            # margin-top: 1;
            split: bottom;
            height: auto;
        }
    }
    &.-mode-ask {
        Question {
            display: block;            
        }
        #text-prompt {
            display: none;
        }
    }

    PromptContainer {       
        &:dark {
            background: black 10%;
        }
        &:light {
            background: white 40%;
        }
        height: auto;
        margin: 0;
        border-bottom: solid $secondary 45%;
        border-subtitle-align: left;
        border-subtitle-style: reverse;
        
        &:focus-within {
            border-bottom: solid $secondary;
            #prompt {
                text-opacity: 100%;
            }
        }
        
        #prompt {
            padding: 0 1;
            text-opacity: 30%;
        }
        
        PromptTextArea {
            padding: 0 1 0 0;
            background: transparent;
            border: none;
            height: auto;
            max-height: 3;

            &:blur {
                text-opacity: 0.5;
            }
        }
    }

    QueuedMessages {
        display: none;
        height: auto;
        max-height: 4;
        overflow: hidden auto;
        margin: 0 1;
        padding: 0 1;
        color: $text-secondary;
        background: $secondary 8%;
        border-left: tall $secondary 45%;
    }

    &.-working-directory-out-of-bounds #info-container CondensedPath {        
        color: $text-error;
    }
    
    #info-container {                
        
        height: 1;
        margin: 0 1;
        # padding: 1 0;
        
        AgentInfo {
            padding: 0 1;
            margin: 0 1 0 0;
            color: $text-primary;
            background: $primary 10%;
            width: auto;
            text-wrap: nowrap;
        }

        CondensedPath { 
            &:first-of-type {
                margin: 0 1 0 0;
            }
            margin: 0 1;
            width: 1fr;            
            height: 1;
            text-wrap: nowrap;
            color: $text-secondary;            
        }

        StatusLine {            
            color: $secondary 70%;    
            margin: 0 1;
            width: auto;
            height: 1;    
            text-align: right;            
            text-wrap: nowrap;
            text-overflow: ellipsis;                           
        }
        
        ModeInfo {
            padding: 0 1;
            margin: 0 0;
            color: $text-secondary;
            background: $secondary 10%;
            dock: right; 
            display: none;
        }        
    }

    &.-has-mode #info-container ModeInfo {
        display: block;
    }

}


ModeInfo:hover {
    text-style: underline;
    pointer: pointer;
}

ModeSwitcher {

    max-height: 50vh;
        
    border: none;
    padding: 0;
    width: auto;    
    max-width: 100;
    
    overlay: screen;
    overflow: hidden;
    constrain: inside inflect;    
    min-width: 12;    
    margin: 1 0;
    height: auto;     
    
    & > .option-list--option {
        padding: 0 1;
    }
   
    &:blur {
        display: none;
    }

    &:focus > .option-list--option-highlighted {
        background: $primary 30%;
        text-style: not bold;
    }
}

MainScreen {    
    background: $background;
    layers: screen base;

}
