
/* Everything CodeSwarm says about itself, rather than relays from an agent.
   It wears no hue: a note is neither a speaker nor a destination. */
Note,MarkdownNote {
    padding: 0 1 0 1;
    background: transparent;
    border-left: solid $content-rule;
    color: $message-meta;
    &.-error {
        /* Red text on its own ground, so a failure never reads as prose an
           agent wrote. */
        background: $message-error-surface;
        border-left: solid $error;
        color: $message-error-foreground;
    }
    &.-stop-reason {
        padding: 0 1;
        MarkdownH2 {
            margin: 0 0 1 0;
        }
    }
    &.-batch-summary {
        margin: 0 1 1 0;
        padding: 0 1 0 1;
        /* Was dressed as agent 0's card. A summary belongs to no speaker. */
        background: transparent;
        border-left: solid $content-rule;
        content-align: left middle;
    }
    &.-agent-identity {
        color: $chrome-text;
        height: 1;
        margin: 1 0 0 0;
        padding: 0;
    }
}


Conversation {    
    Window {                      
        layout: stream;
        margin: 0;                
        scrollbar-size-vertical: 1;
        padding: 0 1 0 0;
        height: 1fr;                
        align: left bottom;   
    }

    &.-scrollbar-hidden {
        Window {
            # scrollbar-gutter: auto;
            scrollbar-size-vertical: 0;
        }
    }

    &.-relay-paused {
        Prompt #prompt-container {
            border: tall $warning;
        }
    }

    height: 1fr;
    layers: base prompt float;        

    
    Contents {        
        layout: stream;
        width: 1fr;
        overflow: hidden;         
        height: auto;  
        padding: 0 0 0 0;                         
    }    

    ContentsGrid {            
        grid-size: 1;
        grid-columns: 1fr;
        grid-rows: auto;
        height: auto;                
    }

    AgentMessage {
        height: auto;
        padding: 0 1 0 1;
        background: $agent-surface-0;
        border-left: vkey $agent-edge-0;

        &.-agent-tone-0 {
            background: $agent-surface-0;
            border-left: vkey $agent-edge-0;
        }
        &.-agent-tone-1 {
            background: $agent-surface-1;
            border-left: vkey $agent-edge-1;
        }
        &.-agent-tone-2 {
            background: $agent-surface-2;
            border-left: vkey $agent-edge-2;
        }
        &.-agent-tone-3 {
            background: $agent-surface-3;
            border-left: vkey $agent-edge-3;
        }

        &.block {
            margin: 0 1 1 0;
        }

        &.-continues {
            margin-bottom: 0;
        }

        &.-continuation #agent-message-header {
            display: none;
        }

        &.-thinking #agent-message-header {
            display: block;
        }

        #agent-message-header {
            height: 1;
            width: 1fr;
            margin: 0 0 1 0;
            padding: 0 1 0 0;
            content-align: left middle;
        }

        AgentToolActivity {
            height: auto;
            min-height: 0;
            margin: 0;
            padding: 0;
            background: transparent;

            #tool-activity-summary {
                height: 1;
                width: 1fr;
                /* No vertical margin: the activity area must stay exactly one
                   row so a new tool call cannot reflow the conversation. The
                   gap above it comes from the response's trailing block. */
                margin: 0 1 0 0;
                color: $message-meta;
                text-overflow: ellipsis;
            }

            ToolCall {
                margin: 0 !important;
            }

        }
    }

    AgentResponse {         
        min-height: 1;        
        margin: 0;
        padding: 0;
        color: $content-body;
        background: transparent;
        link-color: $content-link;
        link-style: underline;
        link-color-hover: $content-link-hover;
        link-background-hover: $content-link-hover-background;
        link-style-hover: bold;

        &:light {
            color: #202326;
        }
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
        layout: stream;

        /* Vertical rhythm. Every block previously used margin: 0, so a
           heading, its prose, a list and a code fence ran together as one
           undifferentiated wall of lines. Separation here is what makes a
           reply skimmable.

           Each block owns its trailing gap, so the last one also supplies the
           card's bottom breathing room (AgentMessage adds no bottom padding).
           Only the leading gap is suppressed, and it is written as the full
           shorthand: in Textual a single-edge margin property rewrites the
           whole box, which would silently drop the trailing gap too. */
        & > MarkdownBlock:first-child {
            margin: 0 0 1 0;
        }

        MarkdownBlock,
        MarkdownTableCellContents {
            link-color: $content-link;
            link-style: underline;
            link-color-hover: $content-link-hover;
            link-background-hover: $content-link-hover-background;
            link-style-hover: bold;
        }

        MarkdownParagraph,
        MarkdownList {
            color: $content-body;

            &:light {
                color: #202326;
            }
        }

        MarkdownBlock {
            margin: 0;

            &:dark > .code_inline {
                background: $content-code-background;
                color: $content-code-foreground;
                text-style: bold;
            }

            &:light > .code_inline {
                background: #F3F3F3;
                color: #0550AE;
            }

            /* A file path is a destination, so it wears the same accent as
               a link. The old magenta chip was a tenth hue competing with
               the speaker rails for attention. */
            & > .file_reference {
                color: $content-link;
            }
        }

        /* Must follow the MarkdownBlock reset above: both selectors carry the
           same specificity, so source order decides which margin survives.
           Direct children only — a descendant selector would also space out
           the paragraph inside every list item and block quote, turning a
           tight list into a double-spaced one. */
        & > MarkdownParagraph,
        & > MarkdownList {
            margin: 0 0 1 0;
        }

        /* A list marker labels content, it is not content: quieter than the
           text beside it, and neutral like the rest of the structure.
           Textual defaults it to $text-primary, i.e. teal. */
        MarkdownBullet {
            color: $message-meta;
        }

        MarkdownHeader {
            /* Brighter than body text and bold — nothing more. Amber read as
               a warning here, and warning is a meaning this app already
               spends elsewhere. */
            color: $content-heading;
            background: transparent;
            text-style: bold;
            /* A section break needs air above it and none below: the
               heading should bind to the text it introduces. */
            margin: 1 0 0 0;

            &:light {
                color: #111827;
            }
        }

        MarkdownFence {
            color: $content-code-fence-foreground;
            background: $content-code-fence-background;
            border-left: solid $content-rule;
            padding: 0 1;
            margin: 1 0;

            &:light {
                color: #465A6E;
                background: #F3F6FA;
                border-left: solid #CBD5E1;
            }
        }

        MarkdownTable {
            /* No fill. A table is the least important thing in a reply and it
               was the loudest: a box around every cell. */
            color: $content-table-foreground;
            background: transparent;
            padding: 0 0;
            margin: 1 0;

            &:light {
                color: #2D3033;
            }
        }

        MarkdownTableContent {
            /* Textual draws the cell grid with a keyline. One rule under the
               header replaces it — enough to read columns, quiet enough to
               ignore. */
            keyline: none;
            grid-gutter: 0 2;
        }

        MarkdownTableContent > .header {
            color: $content-table-header;
            background: transparent;
            text-style: bold;
            border-bottom: solid $content-rule;
            padding: 0 0;
        }

        MarkdownTableContent > .cell {
            padding: 0 0;
        }

        MarkdownTableContent:light > .header {
            color: #111827;
        }

        MarkdownBlockQuote {
            /* Recedes rather than glows: a quote is someone else's words. The
               teal fill made it the brightest band in the reply. */
            color: $content-quote-foreground;
            background: transparent;
            border-left: solid $content-rule;
            padding: 0 1;
            margin: 1 0;

            &:light {
                color: #52606D;
                border-left: solid #CBD5E1;
            }
        }

        MarkdownHorizontalRule {
            display: none;
            border-bottom: solid #8B949E 45%;
            padding-top: 0;
            margin-bottom: 0;

            &:light {
                border-bottom: solid #6B7280 45%;
            }
        }
    }

    LoadingIndicator {
        height: 10;
    }

    AgentThought {
        /* Reasoning is not a destination and not a speaker. It recedes like a
           quote: the teal fill made it the loudest block inside a quiet card. */
        background: transparent;
        color: $content-quote-foreground;
        min-height: 1;
        margin: 1 1 1 0;
        padding:  0 1 0 1;
        border-left: solid $content-rule;
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
        layout: stream;
        MarkdownBlock:last-child {
            margin-bottom: 0;
        }
       
        &.-loading {            
            background: transparent !important;
            border: none;
            padding: 0;
            margin: 0;            
        }
        max-height: 10;
        overflow-y: auto;
        scrollbar-visibility: hidden;

    }

    ToolCall {    
        margin: 0 !important;
        padding-left: 1;
        border-left: solid $content-rule;

        width: 1fr;
        layout: stream;
        height: auto;        

        .icon {
            width: auto;
            margin-right: 1;
        }
        #tool-content {
            display: none;
        }
        &.-has-content #tool-content {            
            margin: 1 1 1 0;            
            DiffView {
                margin: 0 1 1 0;                                              
                &:last-of-type {
                    margin-bottom: 0; 
                }
            }

            Markdown {                
                layout: stream;
                padding: 0;
                margin: 0 0 0 0;
                MarkdownBlock:last-of-type {
                    margin-bottom: 0;
                }
            }                  
        }
        &.-expanded {
            #tool-content {
                display: block;                
            }
            ToolCallHeader {
                text-wrap: wrap;
                text-overflow: fold;
            }
        }
        
        ToolCallHeader {
            color: $chrome-text;
            pointer: pointer;       
            width: auto;
            max-width: 1fr;   
            margin: 0 1 0 0;    
            text-wrap: nowrap;
            text-overflow: ellipsis;
        }        
    }
    padding-left: 1;  

   

    ShellResult {
        border-left: blank $content-rule;
        background: $foreground 4%;        
        padding: 1 0;   
        margin: 1 1 1 0; 
        #prompt {
            margin: 0 1 0 0;
            color: $chrome-text;
        }
    }
    
    Terminal {        
        width: 1fr;
        height: auto;
        padding: 0 1 0 0;
        margin: 1 0;
        overflow: scroll;
        scrollbar-size: 0 0;          
    }

    TerminalTool {
        height: auto;
        /* Neutral while running; -success and -error below already carry the
           only colour a terminal frame needs. */
        border: panel $content-rule;
        border-title-color: $chrome-text-strong;
        background: $chrome-fill;
        padding: 1 1 0 1;              
        border-title-style: bold;

        &.-success {            
            border: panel $success-muted;                  
            border-title-color: $text-success;
            background: $success 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $success 50%;                  
                border-title-color: auto 90%;
            }
        }
        

        &.-error {            
            border: panel $error-muted;                  
            border-title-color: $text-error;
            background: $error 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $error-muted;                  
                border-title-color: auto 90%;
            }
        }
                  
    }
         
    /* The human's turn. It was a right-aligned teal bubble with an orange
       edge — an iMessage bubble borrowed into a terminal, and the loudest
       object on screen for the one message the reader already wrote.

       Now it is the only participant with no hue: same left margin, same
       rail geometry as an agent, colour withheld. That inversion is the
       signal — a coloured rail is an agent, a grey rail is you. */
    UserInput {
        height: auto;
        margin: 0 1 1 0;
        padding: 0;
        align: left top;

        #user-bubble {
            width: 1fr;
            height: auto;
            border-left: vkey $user-edge;
            background: transparent;
            color: $user-foreground;
            padding: 0 1 0 1;

            Markdown {
                padding: 0;
            }
            Markdown > MarkdownBlock:last-child {
                margin-bottom: 0;
            }
            MarkdownFence {
                margin: 0 2 1 0;
            }
        }
    }

    &.-narrow UserInput #user-bubble {
        width: 1fr;
    }

}


ACPToolCallContent {
    Markdown {        
        margin: 0;
        padding-left: 0;
        MarkdownBlock:last-of-type {
            margin-bottom: 0;
        }
    }
}


Prompt {            
    padding: 0;
    height: auto;  
    dock: bottom;  
   
    PathSearch, SlashComplete {
        display: none;
        overlay: screen;
        offset-y: -16;
        height: 16;
        Input {
            margin: 0 1;
            padding: 0 1;
        }
        OptionList,FuzzyPathOptionList {
            border: none;
            height: 1fr;           
            padding: 0;
            margin: 0 1;                     
            overflow: hidden;
            text-wrap: nowrap;
            text-overflow: ellipsis;  
            & > .option-list--option {
                padding: 0 1;             
            }
        }
    }

    &.-show-path-search {
        PathSearch {
            display: block
        }
    }

    &.-show-slash-complete {
        SlashComplete {
            display: block;
        }
    }

    Question {
        
        display: none;
        #title {
            width: 1fr;            
        }
        height: auto;                
        # height: 1fr;
        # max-height: 50vh;
        # overflow: hidden auto;

        #contents {
            
            margin-top: 0;            
            height: auto;            
            overflow: hidden auto;
            max-height: 50vh;  
            margin-bottom: 1;
            
            
            DiffView {
                .diff-group {                    
                    margin-bottom: 0;
                }
            }
            #title {
                margin: 0;
            }
            & > * {                
                # height: 0;
                padding-right: 1;
                margin: 1 0 0 0;
            } 
                     
            &:empty {
                height: 1;                
            }
        }
        #option-container {
            # margin-top: 1;
            split: bottom;
            height: auto;
        }
    }
    &.-mode-ask {
        Question {
            display: block;            
        }
        #text-prompt {
            display: none;
        }
    }

    PromptContainer {       
        &:dark {
            background: black 10%;
        }
        &:light {
            background: white 40%;
        }
        height: auto;
        margin: 0;
        border-bottom: solid $content-rule;
        border-subtitle-align: left;
        border-subtitle-style: reverse;

        /* The one place teal belongs in the chrome: focus is interaction, the
           same idea the accent already carries inside a message. */
        &:focus-within {
            border-bottom: solid $primary;
            #prompt {
                text-opacity: 100%;
            }
        }
        
        #prompt {
            padding: 0 1;
            text-opacity: 30%;
        }
        
        PromptTextArea {
            padding: 0 1 0 0;
            background: transparent;
            border: none;
            height: auto;
            max-height: 3;

            &:blur {
                text-opacity: 0.5;
            }
        }
    }

    QueuedMessages {
        display: none;
        height: auto;
        max-height: 4;
        overflow: hidden auto;
        margin: 0 1;
        padding: 0 1;
        color: $chrome-text;
        background: $chrome-fill;
        border-left: tall $content-rule;

        .queued-message-row {
            width: 1fr;
            height: 1;
        }

        .queued-message-row Label {
            width: 1fr;
            height: 1;
            content-align: left middle;
        }

        .queued-message-cancel {
            width: 3;
            height: 1;
            min-width: 3;
            padding: 0;
            color: $chrome-text;
            background: transparent;
            border: none;

            &:hover {
                color: $text-error;
                background: $text-error 15%;
            }
        }
    }

    &.-working-directory-out-of-bounds #info-container CondensedPath {        
        color: $text-error;
    }
    
    #info-container {                
        
        height: 1;
        margin: 0 1;
        # padding: 1 0;
        
        AgentInfo {
            padding: 0 1;
            margin: 0 1 0 0;
            color: $chrome-text-strong;
            background: $chrome-fill;
            width: auto;
            text-wrap: nowrap;
        }

        CondensedPath { 
            &:first-of-type {
                margin: 0 1 0 0;
            }
            margin: 0 1;
            width: 1fr;            
            height: 1;
            text-wrap: nowrap;
            color: $chrome-text;
        }

        StatusLine {
            color: $chrome-text;
            margin: 0 1;
            width: auto;
            height: 1;    
            text-align: right;            
            text-wrap: nowrap;
            text-overflow: ellipsis;                           
        }
        
        ModeInfo {
            padding: 0 1;
            margin: 0 0;
            color: $chrome-text;
            background: $chrome-fill;
            dock: right; 
            display: none;
        }        

        CollaborationInfo {
            padding: 0 1;
            margin: 0 1 0 0;
            color: $chrome-text-strong;
            background: $chrome-fill;
            text-style: bold;
        }
    }

    &.-has-mode #info-container ModeInfo {
        display: block;
    }

}


ModeInfo:hover,
CollaborationInfo:hover {
    text-style: underline;
    pointer: pointer;
}

CollaborationInfo {
    color: $chrome-text-strong;
}

ModeSwitcher,
CollaborationSwitcher {

    max-height: 50vh;
        
    border: none;
    padding: 0;
    width: auto;    
    max-width: 100;
    
    overlay: screen;
    overflow: hidden;
    constrain: inside inflect;    
    min-width: 12;    
    margin: 1 0;
    height: auto;     
    
    & > .option-list--option {
        padding: 0 1;
    }
   
    &:blur {
        display: none;
    }

    &:focus > .option-list--option-highlighted {
        background: $primary 30%;
        text-style: not bold;
    }
}

MainScreen {    
    background: $background;
    layers: screen base;

}
