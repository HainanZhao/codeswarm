
Note,MarkdownNote {    
    padding: 0 1 0 0;
    background: $primary 5%;
    border-left: solid $primary 45%;
    &.-error {
        background: $error 7%;
        border-left: solid $error;
    }    
    &.-stop-reason {
        border: wide $error 50%;
        padding: 0 1;
        MarkdownH2 {
            margin: 1 0 1 0;
        }
    }
    &.-batch-summary {
        margin: 0 1 1 0;
        padding: 0 1 0 1;
        background: $agent-surface-0;
        border-left: vkey $agent-edge-0 25%;
        content-align: left middle;
    }
    &.-agent-identity {
        color: $text-secondary;
        height: 1;
        margin: 1 0 0 0;
        padding: 0;
    }
}


Conversation {    
    Window {                      
        layout: stream;
        margin: 0;                
        scrollbar-size-vertical: 1;
        padding: 0 1 0 0;
        height: 1fr;                
        align: left bottom;   
    }

    &.-scrollbar-hidden {
        Window {
            # scrollbar-gutter: auto;
            scrollbar-size-vertical: 0;
        }
    }

    &.-relay-paused {
        Prompt #prompt-container {
            border: tall $warning;
        }
    }

    height: 1fr;
    layers: base prompt float;        

    
    Contents {        
        layout: stream;
        width: 1fr;
        overflow: hidden;         
        height: auto;  
        padding: 0 0 0 0;                         
    }    

    ContentsGrid {            
        grid-size: 1;
        grid-columns: 1fr;
        grid-rows: auto;
        height: auto;                
    }

    AgentMessage {
        height: auto;
        padding: 0 1 0 1;
        background: $agent-surface-0;
        border-left: vkey $agent-edge-0 25%;

        &.-agent-tone-0 {
            background: $agent-surface-0;
            border-left: vkey $agent-edge-0 25%;
        }
        &.-agent-tone-1 {
            background: $agent-surface-1;
            border-left: vkey $agent-edge-1 25%;
        }
        &.-agent-tone-2 {
            background: $agent-surface-2;
            border-left: vkey $agent-edge-2 25%;
        }
        &.-agent-tone-3 {
            background: $agent-surface-3;
            border-left: vkey $agent-edge-3 25%;
        }

        &.block {
            margin: 0 1 1 0;
        }

        &.-continues {
            margin-bottom: 0;
        }

        &.-continuation #agent-message-header {
            display: none;
        }

        &.-thinking #agent-message-header {
            display: block;
        }

        #agent-message-header {
            height: 1;
            width: 1fr;
            margin: 0;
            padding: 0 1 0 0;
            content-align: left middle;
        }

        AgentToolActivity {
            height: auto;
            min-height: 0;
            margin: 0;
            padding: 0;
            background: transparent;

            #tool-activity-summary {
                height: 1;
                width: 1fr;
                margin: 0 1 0 0;
                color: $primary;
                text-style: dim;
                text-overflow: ellipsis;
            }

            ToolCall {
                margin: 0 !important;
            }

        }
    }

    AgentResponse {         
        min-height: 1;        
        margin: 0;
        padding: 0;
        color: #E3E6EA;
        background: transparent;
        link-color: $content-link;
        link-style: underline;
        link-color-hover: $content-link-hover;
        link-background-hover: $content-link-hover-background;
        link-style-hover: bold;

        &:light {
            color: #202326;
        }
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
        layout: stream;
        & > MarkdownBlock:last-child {            
            margin-bottom: 0;
        }

        MarkdownBlock,
        MarkdownTableCellContents {
            link-color: $content-link;
            link-style: underline;
            link-color-hover: $content-link-hover;
            link-background-hover: $content-link-hover-background;
            link-style-hover: bold;
        }

        MarkdownParagraph,
        MarkdownList {
            color: #E3E6EA;

            &:light {
                color: #202326;
            }
        }

        MarkdownBlock {
            margin: 0;

            &:dark > .code_inline {
                background: $content-code-background;
                color: $content-code-foreground;
                text-style: bold;
            }

            &:light > .code_inline {
                background: #F3F3F3;
                color: #0550AE;
            }

            & > .file_reference {
                background: $content-file-background;
                color: $content-file-foreground;
                text-style: bold;
            }
        }

        MarkdownHeader {
            color: $content-heading;
            background: transparent;
            text-style: bold;

            &:light {
                color: #111827;
            }
        }

        MarkdownFence {
            color: $content-code-fence-foreground;
            background: $content-code-fence-background;
            border-left: solid $accent 70%;
            padding: 0 1;
            margin: 0;

            &:light {
                color: #465A6E;
                background: #F3F6FA;
                border-left: solid #0F766E 70%;
            }
        }

        MarkdownTable {
            color: $content-table-foreground;
            background: $content-table-background;
            padding: 0 1;
            margin: 0;

            &:light {
                color: #2D3033;
            }
        }

        MarkdownTableContent > .header {
            color: $content-table-header;
            background: #1D3040;
            text-style: bold;
        }

        MarkdownTableContent:light > .header {
            color: #8A5A00;
        }

        MarkdownBlockQuote {
            color: $content-quote-foreground;
            background: $content-quote-background;
            border-left: solid $primary 80%;
            padding: 0 1;
            margin: 0;

            &:light {
                color: #315E5A;
                border-left: solid #0F766E;
            }
        }

        MarkdownHorizontalRule {
            display: none;
            border-bottom: solid #8B949E 45%;
            padding-top: 0;
            margin-bottom: 0;

            &:light {
                border-bottom: solid #6B7280 45%;
            }
        }
    }

    LoadingIndicator {
        height: 10;
    }

    AgentThought {
        background: $primary 6%;
        color: $text-primary;        
        min-height: 1;        
        margin: 1 1 1 0;
        padding:  0 1 0 1;
        border-left: solid $primary 50%;
        border-bottom: solid $primary 20%;
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
        layout: stream;
        MarkdownBlock:last-child {
            margin-bottom: 0;
        }
       
        &.-loading {            
            background: transparent !important;
            border: none;
            padding: 0;
            margin: 0;            
        }
        max-height: 10;
        overflow-y: auto;
        scrollbar-visibility: hidden;

    }

    ToolCall {    
        margin: 0 !important;
        padding-left: 1;
        border-left: solid $primary 25%;
        
        width: 1fr;
        layout: stream;
        height: auto;        

        .icon {
            width: auto;
            margin-right: 1;
        }
        #tool-content {
            display: none;
        }
        &.-has-content #tool-content {            
            margin: 1 1 1 0;            
            DiffView {
                margin: 0 1 1 0;                                              
                &:last-of-type {
                    margin-bottom: 0; 
                }
            }

            Markdown {                
                layout: stream;
                padding: 0;
                margin: 0 0 0 0;
                MarkdownBlock:last-of-type {
                    margin-bottom: 0;
                }
            }                  
        }
        &.-expanded {
            #tool-content {
                display: block;                
            }
            ToolCallHeader {
                text-wrap: wrap;
                text-overflow: fold;
            }
        }
        
        ToolCallHeader {  
            color: $primary;
            pointer: pointer;       
            width: auto;
            max-width: 1fr;   
            margin: 0 1 0 0;    
            text-wrap: nowrap;
            text-overflow: ellipsis;
        }        
    }
    padding-left: 1;  

   

    ShellResult {        
        border-left: blank $primary;
        background: $foreground 4%;        
        padding: 1 0;   
        margin: 1 1 1 0; 
        #prompt {
            margin: 0 1 0 0;
            color: $text-primary;            
        }  
    }
    
    Terminal {        
        width: 1fr;
        height: auto;
        padding: 0 1 0 0;
        margin: 1 0;
        overflow: scroll;
        scrollbar-size: 0 0;          
    }

    TerminalTool {
        height: auto;   
        border: panel $primary 50%;                  
        border-title-color: $text-primary;
        background: $primary 10%;        
        padding: 1 1 0 1;              
        border-title-style: bold;

        &.-success {            
            border: panel $success-muted;                  
            border-title-color: $text-success;
            background: $success 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $success 50%;                  
                border-title-color: auto 90%;
            }
        }
        

        &.-error {            
            border: panel $error-muted;                  
            border-title-color: $text-error;
            background: $error 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $error-muted;                  
                border-title-color: auto 90%;
            }
        }
                  
    }
         
    UserInput {        
        height: auto;
        margin: 0 1 1 0;
        padding: 0;
        align: right top;

        #user-bubble {
            width: 80%;
            height: auto;
            border-top: tall $primary 20%;
            border-bottom: tall $user-edge 55%;
            border-right: tall $user-edge 55%;
            background: $user-surface;
            padding: 0 1 0 2;

            Markdown {
                padding: 0;
            }
            Markdown > MarkdownBlock:last-child {
                margin-bottom: 0;
            }
            MarkdownFence {
                margin: 0 2 1 0;
            }
        }
    }

    &.-narrow UserInput #user-bubble {
        width: 90%;
    }

}


ACPToolCallContent {
    Markdown {        
        margin: 0;
        padding-left: 0;
        MarkdownBlock:last-of-type {
            margin-bottom: 0;
        }
    }
}


Prompt {            
    padding: 0;
    height: auto;  
    dock: bottom;  
   
    PathSearch, SlashComplete {
        display: none;
        overlay: screen;
        offset-y: -16;
        height: 16;
        Input {
            margin: 0 1;
            padding: 0 1;
        }
        OptionList,FuzzyPathOptionList {
            border: none;
            height: 1fr;           
            padding: 0;
            margin: 0 1;                     
            overflow: hidden;
            text-wrap: nowrap;
            text-overflow: ellipsis;  
            & > .option-list--option {
                padding: 0 1;             
            }
        }
    }

    &.-show-path-search {
        PathSearch {
            display: block
        }
    }

    &.-show-slash-complete {
        SlashComplete {
            display: block;
        }
    }

    Question {
        
        display: none;
        #title {
            width: 1fr;            
        }
        height: auto;                
        # height: 1fr;
        # max-height: 50vh;
        # overflow: hidden auto;

        #contents {
            
            margin-top: 0;            
            height: auto;            
            overflow: hidden auto;
            max-height: 50vh;  
            margin-bottom: 1;
            
            
            DiffView {
                .diff-group {                    
                    margin-bottom: 0;
                }
            }
            #title {
                margin: 0;
            }
            & > * {                
                # height: 0;
                padding-right: 1;
                margin: 1 0 0 0;
            } 
                     
            &:empty {
                height: 1;                
            }
        }
        #option-container {
            # margin-top: 1;
            split: bottom;
            height: auto;
        }
    }
    &.-mode-ask {
        Question {
            display: block;            
        }
        #text-prompt {
            display: none;
        }
    }

    PromptContainer {       
        &:dark {
            background: black 10%;
        }
        &:light {
            background: white 40%;
        }
        height: auto;
        margin: 0;
        border-bottom: solid $secondary 45%;
        border-subtitle-align: left;
        border-subtitle-style: reverse;
        
        &:focus-within {
            border-bottom: solid $secondary;
            #prompt {
                text-opacity: 100%;
            }
        }
        
        #prompt {
            padding: 0 1;
            text-opacity: 30%;
        }
        
        PromptTextArea {
            padding: 0 1 0 0;
            background: transparent;
            border: none;
            height: auto;
            max-height: 3;

            &:blur {
                text-opacity: 0.5;
            }
        }
    }

    QueuedMessages {
        display: none;
        height: auto;
        max-height: 4;
        overflow: hidden auto;
        margin: 0 1;
        padding: 0 1;
        color: $text-secondary;
        background: $secondary 8%;
        border-left: tall $secondary 45%;

        .queued-message-row {
            width: 1fr;
            height: 1;
        }

        .queued-message-row Label {
            width: 1fr;
            height: 1;
            content-align: left middle;
        }

        .queued-message-cancel {
            width: 3;
            height: 1;
            min-width: 3;
            padding: 0;
            color: $text-secondary;
            background: transparent;
            border: none;

            &:hover {
                color: $text-error;
                background: $text-error 15%;
            }
        }
    }

    &.-working-directory-out-of-bounds #info-container CondensedPath {        
        color: $text-error;
    }
    
    #info-container {                
        
        height: 1;
        margin: 0 1;
        # padding: 1 0;
        
        AgentInfo {
            padding: 0 1;
            margin: 0 1 0 0;
            color: $text-primary;
            background: $primary 10%;
            width: auto;
            text-wrap: nowrap;
        }

        CondensedPath { 
            &:first-of-type {
                margin: 0 1 0 0;
            }
            margin: 0 1;
            width: 1fr;            
            height: 1;
            text-wrap: nowrap;
            color: $text-secondary;            
        }

        StatusLine {            
            color: $secondary 70%;    
            margin: 0 1;
            width: auto;
            height: 1;    
            text-align: right;            
            text-wrap: nowrap;
            text-overflow: ellipsis;                           
        }
        
        ModeInfo {
            padding: 0 1;
            margin: 0 0;
            color: $text-secondary;
            background: $secondary 10%;
            dock: right; 
            display: none;
        }        

        CollaborationInfo {
            padding: 0 1;
            margin: 0 1 0 0;
            color: $text-primary;
            background: $primary 18%;
            text-style: bold;
        }
    }

    &.-has-mode #info-container ModeInfo {
        display: block;
    }

}


ModeInfo:hover {
    text-style: underline;
    pointer: pointer;
}

CollaborationInfo {
    color: $text-primary;
}

ModeSwitcher {

    max-height: 50vh;
        
    border: none;
    padding: 0;
    width: auto;    
    max-width: 100;
    
    overlay: screen;
    overflow: hidden;
    constrain: inside inflect;    
    min-width: 12;    
    margin: 1 0;
    height: auto;     
    
    & > .option-list--option {
        padding: 0 1;
    }
   
    &:blur {
        display: none;
    }

    &:focus > .option-list--option-highlighted {
        background: $primary 30%;
        text-style: not bold;
    }
}

MainScreen {    
    background: $background;
    layers: screen base;

}
